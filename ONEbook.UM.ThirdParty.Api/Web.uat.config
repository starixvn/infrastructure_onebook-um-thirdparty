<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="ONEbook.UM.ThirdParty.Api" type="ONEbook.UM.ThirdParty.Api.Configurations.UnderMaintenanceApiConfiguration, ONEbook.UM.ThirdParty.Api"  />
  </configSections>
  
  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:10.40.40.73\private$\entlib" defaultCategory="ONEbook-UM-UAT" />

  <ONEbook.UM.ThirdParty.Api
     SecretKey="8oNnvDGiozPj6HVqV7tZZm2mLv+1hguGUQkljwzO59s="
     EnableUnscheduledUM="false"
     UMFrom="03:00"
     UMTo="04:00"
     EnableCheckUM="true">
    <Products>
      <add Id="23" IsUM="false" UMFrom="00:00" UMTo="01:00" />
      <!--For manual control on site-->
    </Products>
  </ONEbook.UM.ThirdParty.Api>
  
  <system.web>
    <compilation debug="false" targetFramework="4.6" />
    <httpRuntime targetFramework="4.6" />
  </system.web>
  
  <appSettings>
    <add key="UMServiceURL" value="http://172.16.4.32:8000/api/UM/|http://172.16.4.32:9000/api/UM/" />
  </appSettings>
  <system.webServer>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>